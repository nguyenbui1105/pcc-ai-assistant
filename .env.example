# LLM provider chain:
#   "groq"        → Groq, then Ollama (default)
#   "nine_router" → each NINE_ROUTER_MODELS entry in order, then Groq, then Ollama
#   "ollama"      → local Ollama only
LLM_PROVIDER=groq

# Groq — get free API key at console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 9Router (only needed when LLM_PROVIDER=nine_router) — start with: python scripts/start_9router.py
NINE_ROUTER_BASE_URL=http://localhost:20128/v1
NINE_ROUTER_API_KEY=local
NINE_ROUTER_MODELS=gc/gemini-3-flash-preview,if/kimi-k2,qw/qwen3-coder-plus

# Ollama (local fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen3:4b

# General
PCC_BASE_URL=https://www.pcc.edu
LOG_LEVEL=INFO
