# LLM Provider: "groq" (cloud, fast) or "ollama" (local)
LLM_PROVIDER=groq

# Groq — get free API key at console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-groq-70b-8192-tool-use-preview

# Ollama (only needed when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen3:4b

# General
PCC_BASE_URL=https://www.pcc.edu
LOG_LEVEL=INFO
